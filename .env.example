STRONG_IMAGE=strong-data:local
PROXY_NETWORK=strong-proxy
STRONG_ENV_FILE=.env
STRONG_SECRET_KEY=replace-with-a-long-random-value
STRONG_DEBUG=false
STRONG_ALLOWED_HOSTS=localhost,127.0.0.1
STRONG_DB_PATH=/app/data/strong.sqlite3
STRONG_STATIC_ROOT=/app/staticfiles
STRONG_CSRF_TRUSTED_ORIGINS=
STRONG_PORT=8000
STRONG_TRUSTED_PROXY=*
